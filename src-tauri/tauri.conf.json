{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DarkBrowser",
  "version": "2.1.2",
  "identifier": "com.darkbyte.ghost",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DarkBrowser",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 21 },
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "1a2b3c4d-5e6f-7890-abcd-ef1234567890"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_DARKBYTE_PUBKEY",
      "endpoints": [
        "https://github.com/darkbyte-browser/darkbyte/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
